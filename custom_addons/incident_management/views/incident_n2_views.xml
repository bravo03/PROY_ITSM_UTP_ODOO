<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- =====================================================
         LISTA DE INCIDENCIAS ASIGNADAS A PROVISIÓN
         ===================================================== -->
    <record id="view_incident_ticket_provision_list" model="ir.ui.view">
        <field name="name">incident.ticket.provision.list</field>
        <field name="model">incident.ticket</field>
        <field name="arch" type="xml">
            <list string="Bandeja BACKOFFICE PROVISION" create="0" delete="0">
                <field name="name" string="Incidencia"/>
                <field name="create_date" string="Fecha de creación"/>
                <field name="process_id"/>
                <field name="application_id"/>
                <field name="summary_id"/>
                <field name="priority"/>
                <field name="assigned_team_id"/>
                <field name="assigned_user_id"/>
                <field name="assigned_date"/>
                <field name="attention_date"/>
                <field name="resolved_date"/>
                <field name="closed_date"/>

                <field name="sla_target_minutes" string="SLA (min)"/>
                <field name="sla_deadline" string="Fecha límite"/>
                <field name="sla_status" string="Estado SLA" widget="badge" decoration-success="sla_status == 'met' or sla_status == 'on_time'" decoration-warning="sla_status == 'warning'" decoration-danger="sla_status == 'breached'"/>

                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- =====================================================
         FORMULARIO OPERATIVO DEL ANALISTA N2
         ===================================================== -->

    <record id="view_incident_ticket_provision_form" model="ir.ui.view">

        <field name="name">incident.ticket.provision.form</field>
        <field name="model">incident.ticket</field>
        <field name="arch" type="xml">
            <form string="Atención de incidencia">

                <header>
                    <button name="action_take_incident" type="object" string="Tomar incidencia" class="btn-primary" invisible="state != 'created'"/>
                    <button name="action_start_attention" type="object" string="Iniciar atención" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_resolve_incident" type="object" string="Resolver incidencia" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_close_incident" type="object" string="Cerrar incidencia" class="btn-secondary" invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="created,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Datos de la incidencia">
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="priority" readonly="1"/>
                            <field name="assigned_team_id" readonly="1"/>
                            <field name="assigned_user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="process_id" readonly="1"/>
                            <field name="application_id" readonly="1"/>
                            <field name="summary_id" readonly="1"/>
                            <field name="generation_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Descripción y evidencia">
                        <field name="description" readonly="1"/>
                        <field name="evidence_ids" widget="many2many_binary" readonly="1"/>
                    </group>

                    <group string="Trazabilidad de la atención">
                        <group>
                            <field name="assigned_date" readonly="1"/>
                            <field name="attention_date" readonly="1"/>
                            <field name="resolved_date" readonly="1"/>
                            <field name="closed_date" readonly="1"/>

                            <field name="sla_target_minutes" readonly="1"/>
                            <field name="sla_deadline" readonly="1"/>
                            <field name="sla_resolution_minutes" readonly="1"/>
                            <field name="sla_status" widget="badge" readonly="1" decoration-success="sla_status == 'met' or sla_status == 'on_time'" decoration-warning="sla_status == 'warning'" decoration-danger="sla_status == 'breached'"/>

                        </group>

                        <group>
                            <field name="suggested_group" readonly="1"/>
                            <field name="confidence" readonly="1"/>
                            <field name="classification_decision" readonly="1"/>
                        </group>
                    </group>

                    <group string="Solución aplicada" invisible="state not in ['assigned', 'in_progress', 'resolved', 'closed']">
                        <field name="resolution_notes" placeholder="Describa las validaciones realizadas y la solución aplicada..." readonly="state in ['resolved', 'closed']"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- =====================================================
         ACCIÓN DE LA BANDEJA PROVISIÓN
         ===================================================== -->

    <record id="action_incident_ticket_provision" model="ir.actions.act_window">
        <field name="name">Bandeja PROVISIÓN</field>
        <field name="res_model">incident.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [
                ('assigned_team_id.code', '=', 'PROVISION'),
                ('state', 'in', ['created', 'assigned', 'in_progress', 'resolved', 'closed'])
            ]
        </field>

        <field name="context">
            {
                'create': False
            }
        </field>
    </record>


    <!-- Vista de lista vinculada explícitamente a la acción -->
    <record id="action_incident_ticket_provision_list_view" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_incident_ticket_provision_list"/>
        <field name="act_window_id" ref="action_incident_ticket_provision"/>
    </record>

    <!-- Vista de formulario vinculada explícitamente a la acción -->
    <record id="action_incident_ticket_provision_form_view" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_incident_ticket_provision_form"/>
        <field name="act_window_id" ref="action_incident_ticket_provision"/>
    </record>
</odoo>