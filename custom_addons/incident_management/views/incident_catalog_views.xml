<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_incident_application_list" model="ir.ui.view">
        <field name="name">incident.application.list</field>
        <field name="model">incident.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="process_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_incident_application_form" model="ir.ui.view">
        <field name="name">incident.application.form</field>
        <field name="model">incident.application</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="process_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_incident_application" model="ir.actions.act_window">
        <field name="name">Aplicaciones</field>
        <field name="res_model">incident.application</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_incident_summary_list" model="ir.ui.view">
        <field name="name">incident.summary.list</field>
        <field name="model">incident.summary</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="process_id"/>
                <field name="application_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_incident_summary_form" model="ir.ui.view">
        <field name="name">incident.summary.form</field>
        <field name="model">incident.summary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="process_id"/>
                        <field name="application_id"
                               domain="[('process_id', '=', process_id)]"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_incident_summary" model="ir.actions.act_window">
        <field name="name">Resúmenes</field>
        <field name="res_model">incident.summary</field>
        <field name="view_mode">list,form</field>
    </record>

 

</odoo>