<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Registro único del dashboard -->
    <record id="incident_dashboard_main"
            model="incident.dashboard">
        <field name="name">Dashboard Operacional</field>
    </record>

    <!-- Vista principal -->
    <record id="view_incident_dashboard_form"
            model="ir.ui.view">

        <field name="name">incident.dashboard.form</field>
        <field name="model">incident.dashboard</field>

        <field name="arch" type="xml">

            <form string="Dashboard Operacional"
                  create="0"
                  edit="0"
                  delete="0">

                <sheet>

                    <div class="oe_title mb-4">
                        <h1>Dashboard Operacional</h1>
                        <h3 class="text-muted">
                            Supervisión de la gestión de incidencias
                        </h3>
                    </div>

                    <div class="row g-3">

                        <!-- Incidencias generadas -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Incidencias generadas
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="total_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Total registrado
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Pendientes -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Pendientes de atención
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="pending_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Aún no tomadas por N2
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Asignadas -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Asignadas
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="assigned_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Con analista responsable
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- En atención -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        En atención
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="in_progress_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Atención técnica activa
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Resueltas -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Resueltas
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="resolved_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Pendientes del cierre definitivo
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Cerradas -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Cerradas
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="closed_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Ciclo de atención finalizado
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Tiempo promedio -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Tiempo promedio
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="average_resolution_minutes"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Minutos hasta la resolución
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Reclasificaciones -->
                        <div class="col-lg-3 col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Reclasificaciones
                                    </h5>
                                    <div class="display-4 fw-bold">
                                        <field name="reclassified_incidents"
                                               nolabel="1"/>
                                    </div>
                                    <span class="text-muted">
                                        Recomendaciones aceptadas
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="alert alert-info mt-4"
                         role="alert">
                        Los indicadores se calculan con la información
                        actual registrada en el módulo de incidencias.
                    </div>

                </sheet>

            </form>

        </field>

    </record>

    <!-- Acción -->
    <record id="action_incident_dashboard"
            model="ir.actions.act_window">

        <field name="name">Dashboard Operacional</field>
        <field name="res_model">incident.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id"
               ref="view_incident_dashboard_form"/>
        <field name="res_id"
               ref="incident_dashboard_main"/>
        <field name="target">current</field>

    </record>

</odoo>