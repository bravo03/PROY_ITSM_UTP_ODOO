<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =====================================================
         VISTA DE LISTA DE INCIDENCIAS
         ===================================================== -->

    <record id="view_incident_ticket_list" model="ir.ui.view">
        <field name="name">incident.ticket.list</field>
        <field name="model">incident.ticket</field>
        <field name="arch" type="xml">
            <list string="Incidencias">
                <field name="create_date" string="Fecha de creación"/>
                <field name="name"/>
                <field name="channel"/>
                <field name="failure_type"/>
                <field name="process_id"/>
                <field name="application_id"/>
                <field name="summary_id"/>
                <field name="suggested_process"/>
                <field name="suggested_group"/>
                <field name="assigned_team_id"/>
                <field name="assigned_date"/>
                <field name="confidence"/>
                <field name="classification_decision"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <!-- =====================================================
         VISTA DE FORMULARIO DEL PORTAL CAC
         ===================================================== -->

    <record id="view_incident_ticket_form" model="ir.ui.view">
        <field name="name">incident.ticket.form</field>
        <field name="model">incident.ticket</field>
        <field name="arch" type="xml">

            <form string="Portal CAC">
                <header>

                    <!-- =================================================
                         PASO 1: REGISTRO El ITSM Copilot se ejecuta automáticamente.
                       ================================================= -->

                    <button name="action_register_incident"
                            type="object"
                            string="Registrar incidencia"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <!-- =================================================
                         PASO 2: DECISIÓN DEL ASESOR
                         ================================================= -->
                    <button name="action_apply_recommendation"
                            type="object"
                            string="Aplicar recomendación"
                            class="btn-primary"
                            invisible="state != 'analyzed' or not is_reclassified or classification_decision == 'accepted'"/>

                    <button name="action_keep_classification"
                            type="object"
                            string="Mantener selección"
                            invisible="state != 'analyzed' or not is_reclassified"/>

                    <!-- =================================================
                         PASO 3: CONFIRMACIÓN FINAL
                         ================================================= -->

                    <button name="action_confirm_generation"
                            type="object"
                            string="Confirmar generación"
                            class="btn-primary"
                            invisible="state != 'analyzed' or classification_decision == 'pending'"/>

                    <!-- Estado del registro -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,analyzed,created,assigned,closed"/>
                </header>

                <sheet>

                    <!-- Encabezado de la pantalla -->
                    <div class="oe_title">
                        <h1>
                            <span>Portal CAC</span>
                        </h1>

                        <h3>
                            <span>
                                Asistente inteligente para el registro de incidencias
                            </span>
                        </h3>

                        <!-- El número INC solo se muestra después de generarse -->
                        <h2 invisible="state != 'created'">
                            <field name="name"
                                   readonly="1"
                                   class="oe_inline"/>
                        </h2>
                    </div>


                    <!-- =================================================
                         PASO 1: CLASIFICACIÓN INICIAL
                         ================================================= -->

                    <group string="1. Clasificación inicial">

                        <group>
                            <field name="channel"/>
                            <field name="failure_type"/>
                        </group>

                        <group>
                            <field name="process_id"
                                   options="{'no_create': True, 'no_open': True}"/>

                            <field name="application_id"
                                   domain="[('process_id', '=', process_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>

                            <field name="summary_id"
                                   domain="[('process_id', '=', process_id), ('application_id', '=', application_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>

                    </group>


                    <!-- =================================================
                         PASO 2: DESCRIPCIÓN Y EVIDENCIAS
                         ================================================= -->

                    <group string="2. Detalle de la incidencia">

                        <field name="description"
                               nolabel="1"
                               placeholder="Describa la falla presentada, el mensaje mostrado y las validaciones realizadas..."/>

                        <field name="evidence_ids"
                               widget="many2many_binary"
                               string="Adjuntar evidencias"/>

                    </group>


                    <!-- =================================================
                         PASO 3: RESULTADO DEL ITSM COPILOT
                         ================================================= -->

                    <group string="3. Resultado del ITSM Copilot"
                           invisible="state == 'draft'">

                        <group string="Clasificación recomendada">
                            <field name="suggested_process"/>
                            <field name="suggested_application"/>
                            <field name="suggested_scenario"/>
                            <field name="suggested_group"/>
                        </group>

                        <group string="Explicación del análisis">
                            <field name="confidence"/>
                            <field name="applied_rule"/>
                            <field name="is_reclassified"/>
                            <field name="classification_decision"/>
                            <field name="analysis_date"/>
                        </group>

                    </group>

                    <group string="Patrones identificados"
                           invisible="state == 'draft'">

                        <field name="matched_patterns"
                               nolabel="1"/>

                    </group>

                    <group string="Recomendación para el Asesor CAC"
                           invisible="state == 'draft'">

                        <field name="reclassification_reason"
                               nolabel="1"/>

                    </group>


                    <!-- =================================================
                         PASO 4: INCIDENCIA GENERADA
                         ================================================= -->

                    <group string="4. Incidencia generada"
                           invisible="state != 'created'">

                        <field name="name"/>
                        <field name="generation_date"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =====================================================
         ACCIONES DE INCIDENCIAS
         ===================================================== -->

    <record id="action_incident_ticket" model="ir.actions.act_window">
        <field name="name">Gestión de incidencias</field>
        <field name="res_model">incident.ticket</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_incident_ticket_register"
            model="ir.actions.act_window">

        <field name="name">Registrar incidencia</field>
        <field name="res_model">incident.ticket</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_incident_ticket_form"/>
        <field name="target">current</field>

        <field name="context">
            {
                'default_state': 'draft'
            }
        </field>

    </record>


    <record id="action_my_incident_tickets"
            model="ir.actions.act_window">

        <field name="name">Mis incidencias</field>
        <field name="res_model">incident.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('create_uid', '=', uid)]</field>
        <field name="context">{}</field>

    </record>


    <!-- =====================================================
         VISTA DE LISTA DE REGLAS
         ===================================================== -->

    <record id="view_incident_rule_list" model="ir.ui.view">
        <field name="name">incident.rule.list</field>
        <field name="model">incident.rule</field>
        <field name="arch" type="xml">

            <list string="Reglas de clasificación">
                <field name="name"/>
                <field name="keywords"/>
                <field name="match_type"/>
                <field name="suggested_process"/>
                <field name="suggested_application"/>
                <field name="suggested_scenario"/>
                <field name="suggested_group"/>
                <field name="weight"/>
                <field name="active"/>
            </list>

        </field>
    </record>


    <!-- =====================================================
         VISTA DE FORMULARIO DE REGLAS
         ===================================================== -->

    <record id="view_incident_rule_form" model="ir.ui.view">
        <field name="name">incident.rule.form</field>
        <field name="model">incident.rule</field>
        <field name="arch" type="xml">

            <form string="Regla de clasificación">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Nombre de la regla"/>
                        </h1>
                    </div>

                    <group string="Configuración de la regla">
                        <field name="keywords"
                               placeholder="reposicion, chip, sim, iccid, bloqueo"/>
                        <field name="match_type"/>
                        <field name="weight"/>
                        <field name="active"/>
                    </group>

                    <group string="Recomendación generada">
                        <field name="suggested_process"/>
                        <field name="suggested_application"/>
                        <field name="suggested_scenario"/>
                        <field name="suggested_group"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =====================================================
         ACCIÓN DE REGLAS
         ===================================================== -->

    <record id="action_incident_rule" model="ir.actions.act_window">
        <field name="name">Reglas de clasificación</field>
        <field name="res_model">incident.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>